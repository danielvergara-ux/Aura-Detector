# ---------------------------------------------------------------------------
# Aura Scanner — environment
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# The app runs with this file empty: Supabase falls back to an in-memory store
# and payments fall back to a local mock checkout.
# ---------------------------------------------------------------------------

# Public base URL. On Vercel this is inferred from VERCEL_URL if omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago ----------------------------------------------------------
# SERVER ONLY.
MERCADO_PAGO_ACCESS_TOKEN=
# Safe to expose (only needed if you add Checkout Bricks later).
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
# Webhook signing secret (Your integrations → Webhooks). Required in production.
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Reroll pricing --------------------------------------------------------
# Server-side truth. The client can never influence the charged amount.
REROLL_PRICE=20
REROLL_CURRENCY=MXN
# Cosmetic label on the button.
NEXT_PUBLIC_REROLL_DISPLAY_PRICE=$20 MXN

# --- Face detection (optional) ---------------------------------------------
# Self-host these to drop the CDN dependency (and tighten the CSP).
# NEXT_PUBLIC_FACE_MODEL_URL=/models/blaze_face_short_range.tflite
# NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=/models/wasm
